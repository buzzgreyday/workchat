# Production env for backend + db + frontend build.
# Copy to backend/.env on the server, fill in real values, keep off git.
#
# Generate strong secrets on the server, e.g.:
#   openssl rand -hex 32       # for JWT_SECRET / TOKEN_HASHING_SECRET / ADMIN_KEY
#   openssl rand -base64 32    # for POSTGRES_PASSWORD

DEV_MODE=0

# OpenAI
OPENAI_API_KEY=sk-...

# Chat model. Optional — with DEV_MODE=0 this defaults to gpt-4.1-mini, which is
# what a hirer should get: it scores better on depth questions than the cheaper
# gpt-4.1-nano, and at a 20-query token per hiring manager the difference is a
# latency decision rather than a cost one. Only set this to move deliberately.
# OPENAI_MODEL=gpt-4.1-mini

# JWT signing key for access tokens
JWT_SECRET=

# Hashing pepper applied server-side to access tokens before storage
TOKEN_HASHING_SECRET=

# Admin key required by /admin routes to mint tokens
ADMIN_KEY=

# --- Your domain ---------------------------------------------------------
# Hostnames you control. DNS for both SITE_DOMAIN and API_DOMAIN must already
# point at this host, or Caddy's certificate requests will fail.

# Site address in the Caddyfile; Caddy requests the TLS certificate for it.
SITE_DOMAIN=chat.example.com

# The API's own host, served by the same Caddy (no scheme). The chat frontend
# is built to call https://<this>, and pages embedding the chat point its
# `api-url` here. SITE_DOMAIN/api keeps answering too. The two must be on the
# same registrable domain as the pages that use them (here example.com), or
# the SameSite=Strict refresh cookie will not be sent.
API_DOMAIN=api.example.com

# Contact address Let's Encrypt uses for expiry/problem notices.
ACME_EMAIL=you@example.com

# Public base URL — used when embedding token links in QR codes etc.
BASE_URL=https://chat.example.com

# CORS-allowed origins, comma-separated. Scheme required.
ALLOWED_HOSTS=https://chat.example.com

# --- Whose CV this is ------------------------------------------------------
# The chat header and the browser tab. Read by the frontend server on each
# request, so changing one takes a `docker compose restart frontend` and not a
# rebuild. A link left empty is simply not rendered.
OWNER_NAME=Your Name
OWNER_GITHUB_URL=https://github.com/your-handle
OWNER_LINKEDIN_URL=https://linkedin.com/in/your-handle
OWNER_WEBSITE_URL=https://your-site.example

# Database (used by db service and backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=db

# --- v2 token flow -------------------------------------------------------
# All optional: the defaults shown are what the code uses when these are unset,
# and a deployment that never issues a version=2 link is unaffected by any of
# them. Uncomment only to override.

# Lifetime of a v2 access token, in seconds. Short on purpose — it is the half
# the browser can read, so a leak should go stale on its own.
# ACCESS_TOKEN_TTL_SECONDS=900

# Lifetime of a v2 refresh token, in seconds. Clamped to the grant's own expiry
# when minted, so this is a ceiling rather than a promise.
# REFRESH_TOKEN_TTL_SECONDS=604800

# How long after rotation a refresh token is still read as this client retrying
# rather than someone replaying a stolen one. Raise it if clients sit behind
# flaky mobile networks; lower it to shrink the window a thief could exploit.
# REFRESH_ROTATION_GRACE_SECONDS=30

# Minimum gap between operator notices about the same grant, in seconds. Stops a
# dead claim link being hit in a loop from filling the log.
# OWNER_NOTIFY_THROTTLE_SECONDS=3600

# Name of the httpOnly cookie carrying the refresh token.
# REFRESH_COOKIE_NAME=cv_refresh

# --- Guest trials ---------------------------------------------------------
# A visitor with no link can ask a few questions after an invisible
# proof-of-work, once per IP address per UTC day, within a daily ceiling for
# everyone. Off unless TRIAL_ENABLED is set; the rest are optional and show
# their defaults. Addresses are never stored: only an HMAC of each under a key
# that changes daily, deleted when its day ends (see docs/privacy.md).
# TRIAL_ENABLED=0
# Required while trials are on. Keys for the proof-of-work and the daily
# address hashes are derived from it; generate with `openssl rand -hex 32`.
# TRIAL_SECRET=
# Questions per trial, and how long a trial lasts (seconds).
# TRIAL_MAX_QUERIES=3
# TRIAL_TTL_SECONDS=86400
# Days a browser that has had a trial is not offered another (the cv_trial
# cookie, holding only the trial's date).
# TRIAL_COOKIE_DAYS=30
# Trials per UTC day across everyone: the most strangers can cost you in a day
# is TRIAL_DAILY_LIMIT x TRIAL_MAX_QUERIES questions.
# TRIAL_DAILY_LIMIT=50
# Proof-of-work difficulty: the hashes a browser searches, half on average.
# TRIAL_POW_MAX_NUMBER=100000

# --- Signed chat history -------------------------------------------------
# The server signs the conversation history it hands back each turn and only
# believes one it signed. Optional: unset, the key is derived from JWT_SECRET.
# Rotating it sends conversations in flight back to a fresh start, nothing more.
# HISTORY_SIGNING_SECRET=

# TRUST_PROXY_HEADERS is set in docker-compose.prod.yaml, not here: it is true
# exactly because the backend is reachable only through Caddy.

# Only for pointing tooling at a database outside the compose network, e.g.
# running alembic from the host. Leave unset in production: the URL is assembled
# from POSTGRES_* above and the `db` service name.
# DATABASE_URL=
