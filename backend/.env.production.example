# Production env for backend + db + frontend build.
# Copy to backend/.env on the server, fill in real values, keep off git.
#
# Generate strong secrets on the server, e.g.:
#   openssl rand -hex 32       # for JWT_SECRET / TOKEN_HASHING_SECRET / ADMIN_KEY
#   openssl rand -base64 32    # for POSTGRES_PASSWORD

DEV_MODE=0

# OpenAI
OPENAI_API_KEY=sk-...

# JWT signing key for access tokens
JWT_SECRET=

# Hashing pepper applied server-side to access tokens before storage
TOKEN_HASHING_SECRET=

# Admin key required by /admin routes to mint tokens
ADMIN_KEY=

# --- Your domain ---------------------------------------------------------
# All four must refer to the same hostname you control, and DNS for it must
# already point at this host or Caddy's certificate request will fail.

# Site address in the Caddyfile; Caddy requests the TLS certificate for it.
SITE_DOMAIN=chat.example.com

# Contact address Let's Encrypt uses for expiry/problem notices.
ACME_EMAIL=you@example.com

# Public base URL — used when embedding token links in QR codes etc.
BASE_URL=https://chat.example.com

# CORS-allowed origins, comma-separated. Scheme required.
ALLOWED_HOSTS=https://chat.example.com

# Database (used by db service and backend)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=db

# --- v2 token flow -------------------------------------------------------
# All optional: the defaults shown are what the code uses when these are unset,
# and a deployment that never issues a version=2 link is unaffected by any of
# them. Uncomment only to override.

# Lifetime of a v2 access token, in seconds. Short on purpose — it is the half
# the browser can read, so a leak should go stale on its own.
# ACCESS_TOKEN_TTL_SECONDS=900

# Lifetime of a v2 refresh token, in seconds. Clamped to the grant's own expiry
# when minted, so this is a ceiling rather than a promise.
# REFRESH_TOKEN_TTL_SECONDS=604800

# How long after rotation a refresh token is still read as this client retrying
# rather than someone replaying a stolen one. Raise it if clients sit behind
# flaky mobile networks; lower it to shrink the window a thief could exploit.
# REFRESH_ROTATION_GRACE_SECONDS=30

# Minimum gap between operator notices about the same grant, in seconds. Stops a
# dead claim link being hit in a loop from filling the log.
# OWNER_NOTIFY_THROTTLE_SECONDS=3600

# Name of the httpOnly cookie carrying the refresh token.
# REFRESH_COOKIE_NAME=cv_refresh

# Only for pointing tooling at a database outside the compose network, e.g.
# running alembic from the host. Leave unset in production: the URL is assembled
# from POSTGRES_* above and the `db` service name.
# DATABASE_URL=
