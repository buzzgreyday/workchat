{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "correlation": {
      "()": "app.common.logging.filters.CorrelationFilter"
    }
  },
  "formatters": {
    "json": {
      "()": "app.common.logging.formatters.JsonExtraFormatter"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "filters": ["correlation"],
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": ["console"],
      "level": "ERROR",
      "propagate": false
    },
    "openai": {
      "level": "INFO"
    },
    "httpx": {
      "level": "WARNING"
    }
  },
  "root": {
    "level": "DEBUG",
    "handlers": ["console"]
  }
}
