# Local development env for the backend + db.
# Copy to backend/.env and adjust. See .env.production.example for the server.
#
# Compose also needs a copy at the repo root for ${POSTGRES_USER} interpolation;
# symlink rather than duplicate:  ln -s backend/.env .env

DEV_MODE=1

# OpenAI API Key (Required)
OPENAI_API_KEY=change-this-to-your-openai-secret-key

# JWT Secret Key for access token signing (Required for secure API)
JWT_SECRET=your-jwt-secret-key-here

# Admin Password (for initial admin user)
ADMIN_KEY=admin

# Hash access token before storing
TOKEN_HASHING_SECRET=server_side_password

# Public base URL. Required whenever DEV_MODE is not 1.
BASE_URL=http://localhost:8000

# CORS-allowed origins, comma-separated. Required in production; in dev it only
# *adds* to localhost:3000 and 127.0.0.1:3000, which are always allowed, so a
# frontend on another port goes here. Entries need a scheme to count: matching is
# by exact string, so a bare domain or a pattern like *.example.com can never
# match an Origin header and is skipped in dev rather than shadowing the
# defaults. Note "*" is not usable at all now — the refresh cookie makes these
# credentialed requests, and browsers reject a wildcard for those.
ALLOWED_HOSTS="http://localhost:3000"

# DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db

# --- v2 token flow -------------------------------------------------------
# Optional, and inert until you mint a link with version=2 — the defaults shown
# are what the code uses when these are unset. Uncomment only to override.

# Lifetime of a v2 access token, in seconds. Worth dropping to 60 or so while
# working on the refresh path, so rotation actually happens while you watch
# rather than once every fifteen minutes.
# ACCESS_TOKEN_TTL_SECONDS=900

# Lifetime of a v2 refresh token, in seconds. Clamped to the grant's own expiry
# when minted, so this is a ceiling rather than a promise.
# REFRESH_TOKEN_TTL_SECONDS=604800

# How long after rotation a refresh token still reads as this client retrying
# rather than someone replaying a stolen one. Set it to 0 to exercise the replay
# path — every second refresh of the same token will then cut the grant.
# REFRESH_ROTATION_GRACE_SECONDS=30

# Minimum gap between operator notices about the same grant, in seconds. Worth
# setting to 0 locally so every reuse logs instead of one per hour.
# OWNER_NOTIFY_THROTTLE_SECONDS=3600

# Name of the httpOnly cookie carrying the refresh token. Its Secure flag is not
# configurable — it follows DEV_MODE, off here so the cookie works over plain
# http on localhost.
# REFRESH_COOKIE_NAME=cv_refresh

# --- Local debugging -----------------------------------------------------

# Logs message and reply text. Off by default and meant to stay off outside
# local work: logs are an unencrypted Docker ring buffer with no retention or
# redaction path, unlike the chat content in Postgres.
# LOG_CHAT_CONTENT=0

# Days before chat content is scrubbed by scripts/purge-chat-content.sh.
# CHAT_RETENTION_DAYS=30

# Only for pointing tooling at a database outside the compose network — running
# alembic or psql from the host, where the `db` hostname does not resolve:
#   DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/db
# Leave unset when running inside compose.
# DATABASE_URL=
