DEV_MODE=1

# OpenAI API Key (Required)
OPENAI_API_KEY=change-this-to-your-openai-secret-key

# JWT Secret Key for access token signing (Required for secure API)
JWT_SECRET=your-jwt-secret-key-here

# Admin Password (for initial admin user)
ADMIN_KEY=admin

# Hash access token before storing
TOKEN_HASHING_SECRET=server_side_password

# Public base URL. Required whenever DEV_MODE is not 1.
BASE_URL=http://localhost:8000

# CORS-allowed origins, comma-separated. Scheme required.
ALLOWED_HOSTS="http://localhost:3000"

# DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=db