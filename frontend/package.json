{
  "name": "frontend",
  "version": "0.13.1",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:embed && next build",
    "build:embed": "node embed/build.mjs",
    "watch:embed": "node embed/build.mjs --watch",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:contract": "npm run build:embed && node embed/contract.mjs",
    "build:standalone": "npm run build && mkdir -p .next/standalone/public .next/standalone/.next/static && cp -r public/. .next/standalone/public/ && cp -r .next/static/. .next/standalone/.next/static/"
  },
  "dependencies": {
    "jwt-decode": "^4.0.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.12",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "typescript": "^5"
  }
}
